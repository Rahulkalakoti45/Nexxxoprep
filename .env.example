# Copy to .env and fill in. Never commit .env.

# Backend
NODE_ENV=development
SERVER_PORT=4000
DATABASE_URL=postgresql://USER@localhost:5432/nexoprep
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
# Any random string; the frontend must send the same value (VITE_API_KEY below).
API_KEY_DEV_ONLY=

# AI services (optional: without them the app falls back to built-in features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Frontend (Vite exposes only VITE_ variables to the browser)
VITE_API_BASE_URL=http://localhost:4000
VITE_API_KEY=
