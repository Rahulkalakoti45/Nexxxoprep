{
  "name": "nexxxoprep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "npm run dev -w @nexoprep/server",
    "build:server": "npm run build -w @nexoprep/server",
    "start:server": "npm run start -w @nexoprep/server",
    "db:generate": "npm run db:generate -w @nexoprep/database",
    "db:migrate": "npm run db:migrate -w @nexoprep/database",
    "db:deploy": "npm run db:deploy -w @nexoprep/database",
    "test": "node --test src/features/behavior/analysis.test.js"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.8.1",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "fast-check": "^4.8.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
